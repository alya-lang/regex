## # regex/utils
##
## Character inspection, case folding, and regex escaping utilities.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Supports ASCII and multilingual Unicode workloads (Turkish, Latin Extended,
## Cyrillic, Greek) with byte-level UTF-8 case folding helpers.

# ───────────────────────────────────────────────────────────────
# Character Classification
# ───────────────────────────────────────────────────────────────

## Checks whether a single character is an ASCII letter `[a-zA-Z]`.
##
## ### Parameters
## - `ch`: Single-character string to inspect.
##
## ### Returns
## `1` when the character is an ASCII letter, `0` otherwise.
##
## ### Examples
## ```alya
## say is_ascii_letter("G") # 1
## say is_ascii_letter("5") # 0
## ```
pub function is_ascii_letter(ch: string) -> int
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
        return 1
    end
    return 0
end

## Checks whether a single character is an ASCII digit `[0-9]`.
##
## ### Parameters
## - `ch`: Single-character string to inspect.
##
## ### Returns
## `1` when the character is a digit, `0` otherwise.
##
## ### Examples
## ```alya
## say is_digit("7") # 1
## ```
pub function is_digit(ch: string) -> int
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    if c >= 48 and c <= 57
        return 1
    end
    return 0
end

## Checks whether a single character is a hexadecimal digit `[0-9a-fA-F]`.
##
## ### Parameters
## - `ch`: Single-character string to inspect.
##
## ### Returns
## `1` when the character is a hex digit, `0` otherwise.
pub function is_hex_digit(ch: string) -> int
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    if (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
        return 1
    end
    return 0
end

## Returns the numeric integer value of a hexadecimal character.
##
## Non-hex input safely maps to `0`.
##
## ### Parameters
## - `ch`: Single-character hex string.
##
## ### Returns
## Integer value in the range `0..15`.
##
## ### Examples
## ```alya
## say hex_char_val("f") # 15
## ```
pub function hex_char_val(ch: string) -> int
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    when c
        is 48..57 => return c - 48
        is 65..70 => return c - 55
        is 97..102 => return c - 87
        else => return 0
    end
end

## Converts a Unicode code point to a list of UTF-8 byte integers.
##
## ### Parameters
## - `cp`: Unicode code point integer.
##
## ### Returns
## Array of 1-4 UTF-8 byte integers.
##
## ### Examples
## ```alya
## say codepoint_to_utf8(231) # [195, 167]
## ```
pub function codepoint_to_utf8(cp: int) -> array
    when cp
        is < 128
            return [cp]
        is < 2048
            return [192 + (cp / 64), 128 + (cp % 64)]
        is < 65536
            let b1 = 224 + (cp / 4096)
            let b2 = 128 + ((cp / 64) % 64)
            let b3 = 128 + (cp % 64)
            return [b1, b2, b3]
        else
            let b1 = 240 + (cp / 262144)
            let b2 = 128 + ((cp / 4096) % 64)
            let b3 = 128 + ((cp / 64) % 64)
            let b4 = 128 + (cp % 64)
            return [b1, b2, b3, b4]
    end
end

## Checks whether a character is a word character `[a-zA-Z0-9_]`.
##
## Bytes in the `192..255` range (multilingual lead bytes) count as word
## characters so `\b` and `\w` behave across languages.
##
## ### Parameters
## - `ch`: Single-character string to inspect.
##
## ### Returns
## `1` when the character is a word character, `0` otherwise.
pub function is_word_char(ch: string) -> int
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
        return 1
    end
    # Include common Latin/Turkish single-byte or lead bytes
    if c >= 192 and c <= 255
        return 1
    end
    return 0
end

## Checks whether a character is a whitespace character `[\s]`.
##
## Covers space, tab, newline, carriage return, form feed, and vertical tab.
##
## ### Parameters
## - `ch`: Single-character string to inspect.
##
## ### Returns
## `1` when the character is whitespace, `0` otherwise.
pub function is_space_char(ch: string) -> int
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    # space (32), tab (9), newline (10), carriage return (13), form feed (12), vertical tab (11)
    if c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12
        return 1
    end
    return 0
end

# ───────────────────────────────────────────────────────────────
# Case Folding
# ───────────────────────────────────────────────────────────────

## Converts a single-byte ASCII character code to lowercase (`[A-Z]` to `[a-z]`).
##
## Non-uppercase codes pass through unchanged.
##
## ### Parameters
## - `code`: ASCII character code integer.
##
## ### Returns
## Lowercased character code integer.
pub function to_lower_code(code: int) -> int
    return when code
        is 65..90 => code + 32
        else => code
    end
end

## Maps a 2-byte UTF-8 sequence `[b1, b2]` to its lowercase `[b1_low, b2_low]`.
##
## Covers Latin-1 Supplement, Latin Extended-A (Turkish `Ğ`/`Ş`), Cyrillic,
## and Greek ranges. A trailing `-1` signals a fold into single-byte ASCII
## (e.g. Turkish uppercase `İ` becomes lowercase `i`).
##
## ### Parameters
## - `b1`: Lead byte integer.
## - `b2`: Continuation byte integer.
##
## ### Returns
## Two-element array with the lowercased byte pair.
##
## ### Examples
## ```alya
## say to_lower_utf8_pair(196, 158) # [196, 159]
## ```
pub function to_lower_utf8_pair(b1: int, b2: int) -> array
    # Latin-1 Supplement (0xC3 = 195) - French, German, Spanish, Scandinavian, Portuguese...
    # Ä/ä (132->164), É/é (137->169), Ñ/ñ (145->177), Ö/ö (150->182), Ü/ü (156->188), Ç/ç (135->167)...
    if b1 == 195
        if b2 >= 128 and b2 <= 158 and b2 != 151
            return [195, b2 + 32]
        end
        return [b1, b2]
    end

    # Latin Extended-A (0xC4 = 196) - Turkish Ğ, İ, Polish/Czech/Hungarian/Baltic...
    if b1 == 196
        if b2 == 158 return [196, 159] end # Ğ -> ğ
        if b2 == 176 return [105, -1] end  # İ -> i (becomes 1-byte ASCII)
        if (b2 % 2 == 0) and b2 >= 128 and b2 <= 174
            return [196, b2 + 1] # Ā->ā, Ć->ć, Č->č, Ď->ď...
        end
        return [b1, b2]
    end

    # Latin Extended-A (0xC5 = 197) - Turkish Ş, Polish Ł, Ś, Ž...
    if b1 == 197
        if b2 == 158 return [197, 159] end # Ş -> ş
        if (b2 % 2 == 1) and b2 >= 129 and b2 <= 147
            return [197, b2 + 1] # Ł->ł, Ń->ń, Ň->ň...
        end
        if (b2 % 2 == 0) and b2 >= 160 and b2 <= 190 and (b2 < 185 or b2 > 188)
            return [197, b2 + 1] # Š->š, Ť->ť, Ž->ž...
        end
        if (b2 % 2 == 1) and b2 >= 185 and b2 <= 188
            return [197, b2 + 1] # Ź->ź (185->186), Ż->ż (187->188)
        end
        return [b1, b2]
    end

    # Cyrillic (0xD0 = 208, 0xD1 = 209) - Russian, Ukrainian, Bulgarian, Serbian
    if b1 == 208
        when b2
            is 144..159 => return [208, b2 + 32] # А-П -> а-п
            is 160..175 => return [209, b2 - 32] # Р-Я -> р-я
            is 129 => return [209, 145]          # Ё -> ё
            is 132 => return [209, 148]          # Є -> є
            is 134 => return [209, 150]          # І -> і
            is 135 => return [209, 151]          # Ї -> ї
            else => return [b1, b2]
        end
    end

    # Greek (0xCE = 206, 0xCF = 207)
    if b1 == 206
        if b2 >= 145 and b2 <= 159
            return [206, b2 + 32] # Α-Ο -> α-ο
        elif b2 >= 160 and b2 <= 169
            return [207, b2 - 32] # Π-Ω -> π-ω
        end
        return [b1, b2]
    end

    return [b1, b2]
end

## Converts a single character to lowercase.
##
## ### Parameters
## - `ch`: Single-character string.
##
## ### Returns
## Lowercased character string (empty input yields `""`).
pub function to_lower_char(ch: string) -> string
    if len(ch) == 0 return "" end
    let c = ord(ch)
    let lc = to_lower_code(c)
    if lc != c
        return chr(lc)
    end
    return ch
end

## Converts an entire string to lowercase (ASCII, Latin Extended, Cyrillic, Greek).
##
## ### Parameters
## - `s`: Input string.
##
## ### Returns
## Lowercased string preserving multibyte sequences.
##
## ### Examples
## ```alya
## say to_lower_string("ÖĞRENCİ") # "öğrenci"
## ```
pub function to_lower_string(s: string) -> string
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        let b1 = ord(char_at(s, i))
        if b1 < 128
            # ASCII [A-Z] -> [a-z]
            if b1 >= 65 and b1 <= 90
                res += chr(b1 + 32)
            else
                res += char_at(s, i)
            end
            i += 1
        elif (b1 == 195 or b1 == 196 or b1 == 197 or b1 == 206 or b1 == 208) and i + 1 < slen
            let b2 = ord(char_at(s, i + 1))
            let pair = to_lower_utf8_pair(b1, b2)
            if pair[1] == -1
                res += chr(pair[0])
            else
                res += chr(pair[0]) + chr(pair[1])
            end
            i += 2
        else
            res += char_at(s, i)
            i += 1
        end
    end
    return res
end

# ───────────────────────────────────────────────────────────────
# Assertions & Escaping
# ───────────────────────────────────────────────────────────────

## Checks whether a position in text matches a word boundary `\b` or `\B`.
##
## ### Parameters
## - `text`: Input text string.
## - `pos`: Byte position to test.
## - `text_len`: Total text byte length.
## - `is_positive`: `1` for `\b`, `0` for `\B`.
##
## ### Returns
## `1` when the assertion holds at `pos`, `0` otherwise.
pub function check_word_boundary(text: string, pos: int, text_len: int, is_positive: int) -> int
    let before_word = 0
    let after_word = 0
    if pos > 0
        before_word = is_word_char(char_at(text, pos - 1))
    end
    if pos < text_len
        after_word = is_word_char(char_at(text, pos))
    end

    let is_bound = 0
    if before_word != after_word
        is_bound = 1
    end

    return when
        is_positive == 1 => is_bound
        is_bound == 1    => 0
        else             => 1
    end
end

## Escapes all regular expression meta-characters in a literal string.
##
## ### Parameters
## - `str_val`: Raw literal string.
##
## ### Returns
## Escaped string safe to embed in a pattern.
##
## ### Examples
## ```alya
## say escape_pattern("file.name*") # "file\\.name\\*"
## ```
pub function escape_pattern(str_val: string) -> string
    let slen = len(str_val)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(str_val, i)
        if ch == "\\" or ch == "^" or ch == "$" or ch == "." or ch == "*" or ch == "+" or ch == "?" or ch == "(" or ch == ")" or ch == "[" or ch == "]" or ch == "{" or ch == "}" or ch == "|" or ch == "/" or ch == "-"
            res += "\\"
            res += ch
        else
            res += ch
        end
        i += 1
    end
    return res
end
