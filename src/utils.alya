# Character inspection, case folding, and regex escaping utilities
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Checks if a single character is an ASCII letter [a-zA-Z]
function is_ascii_letter(ch)
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
        return 1
    end
    return 0
end

# Checks if a single character is an ASCII digit [0-9]
function is_digit(ch)
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    if c >= 48 and c <= 57
        return 1
    end
    return 0
end

# Checks if a single character is a hexadecimal digit [0-9a-fA-F]
function is_hex_digit(ch)
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    if (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
        return 1
    end
    return 0
end

# Returns numeric integer value of a hexadecimal character
function hex_char_val(ch)
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    if c >= 48 and c <= 57
        return c - 48
    elif c >= 65 and c <= 70
        return c - 55
    elif c >= 97 and c <= 102
        return c - 87
    end
    return 0
end

# Converts a Unicode code point to a list of UTF-8 byte integers
function codepoint_to_utf8(cp)
    if cp < 128
        return [cp]
    elif cp < 2048
        return [192 + (cp / 64), 128 + (cp % 64)]
    elif cp < 65536
        let b1 = 224 + (cp / 4096)
        let b2 = 128 + ((cp / 64) % 64)
        let b3 = 128 + (cp % 64)
        return [b1, b2, b3]
    else
        let b1 = 240 + (cp / 262144)
        let b2 = 128 + ((cp / 4096) % 64)
        let b3 = 128 + ((cp / 64) % 64)
        let b4 = 128 + (cp % 64)
        return [b1, b2, b3, b4]
    end
end

# Checks if a character is a word character [a-zA-Z0-9_]
function is_word_char(ch)
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
        return 1
    end
    # Include common Latin/Turkish single-byte or lead bytes
    if c >= 192 and c <= 255
        return 1
    end
    return 0
end

# Checks if a character is a whitespace character [\s]
function is_space_char(ch)
    if len(ch) == 0 return 0 end
    let c = ord(ch)
    # space (32), tab (9), newline (10), carriage return (13), form feed (12), vertical tab (11)
    if c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12
        return 1
    end
    return 0
end

# Converts single-byte ASCII character code to lowercase [A-Z] -> [a-z]
function to_lower_code(code)
    if code >= 65 and code <= 90
        return code + 32
    end
    return code
end

# Takes a 2-byte UTF-8 sequence [b1, b2] and returns the lowercase [b1_low, b2_low]
function to_lower_utf8_pair(b1, b2)
    # Latin-1 Supplement (0xC3 = 195) - French, German, Spanish, Scandinavian, Portuguese...
    # Ä/ä (132->164), É/é (137->169), Ñ/ñ (145->177), Ö/ö (150->182), Ü/ü (156->188), Ç/ç (135->167)...
    if b1 == 195
        if b2 >= 128 and b2 <= 158 and b2 != 151
            return [195, b2 + 32]
        end
        return [b1, b2]
    end

    # Latin Extended-A (0xC4 = 196) - Turkish Ğ, İ, Polish/Czech/Hungarian/Baltic...
    if b1 == 196
        if b2 == 158 return [196, 159] end # Ğ -> ğ
        if b2 == 176 return [105, -1] end  # İ -> i (becomes 1-byte ASCII)
        if (b2 % 2 == 0) and b2 >= 128 and b2 <= 174
            return [196, b2 + 1] # Ā->ā, Ć->ć, Č->č, Ď->ď...
        end
        return [b1, b2]
    end

    # Latin Extended-A (0xC5 = 197) - Turkish Ş, Polish Ł, Ś, Ž...
    if b1 == 197
        if b2 == 158 return [197, 159] end # Ş -> ş
        if (b2 % 2 == 1) and b2 >= 129 and b2 <= 147
            return [197, b2 + 1] # Ł->ł, Ń->ń, Ň->ň...
        end
        if (b2 % 2 == 0) and b2 >= 160 and b2 <= 190 and (b2 < 185 or b2 > 188)
            return [197, b2 + 1] # Š->š, Ť->ť, Ž->ž...
        end
        if (b2 % 2 == 1) and b2 >= 185 and b2 <= 188
            return [197, b2 + 1] # Ź->ź (185->186), Ż->ż (187->188)
        end
        return [b1, b2]
    end

    # Cyrillic (0xD0 = 208, 0xD1 = 209) - Russian, Ukrainian, Bulgarian, Serbian
    if b1 == 208
        if b2 >= 144 and b2 <= 159
            return [208, b2 + 32] # А-П -> а-п
        elif b2 >= 160 and b2 <= 175
            return [209, b2 - 32] # Р-Я -> р-я
        elif b2 == 129
            return [209, 145]     # Ё -> ё
        elif b2 == 132
            return [209, 148]     # Є -> є
        elif b2 == 134
            return [209, 150]     # І -> і
        elif b2 == 135
            return [209, 151]     # Ї -> ї
        end
        return [b1, b2]
    end

    # Greek (0xCE = 206, 0xCF = 207)
    if b1 == 206
        if b2 >= 145 and b2 <= 159
            return [206, b2 + 32] # Α-Ο -> α-ο
        elif b2 >= 160 and b2 <= 169
            return [207, b2 - 32] # Π-Ω -> π-ω
        end
        return [b1, b2]
    end

    return [b1, b2]
end

# Converts a single character to lowercase
function to_lower_char(ch)
    if len(ch) == 0 return "" end
    let c = ord(ch)
    let lc = to_lower_code(c)
    if lc != c
        return chr(lc)
    end
    return ch
end

# Converts an entire string to lowercase (supporting ASCII, Latin Extended, Cyrillic, Greek, etc.)
function to_lower_string(s)
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        let b1 = ord(char_at(s, i))
        if b1 < 128
            # ASCII [A-Z] -> [a-z]
            if b1 >= 65 and b1 <= 90
                res += chr(b1 + 32)
            else
                res += char_at(s, i)
            end
            i += 1
        elif b1 == 195 and i + 1 < slen
            # Latin-1 Supplement (0xC3) - French, German, Spanish, Scandinavian...
            let b2 = ord(char_at(s, i + 1))
            if b2 >= 128 and b2 <= 158 and b2 != 151
                res += chr(195) + chr(b2 + 32)
            else
                res += char_at(s, i) + char_at(s, i + 1)
            end
            i += 2
        elif b1 == 196 and i + 1 < slen
            # Latin Extended-A (0xC4) - Turkish Ğ, İ and Polish/Czech...
            let b2 = ord(char_at(s, i + 1))
            if b2 == 158
                res += chr(196) + chr(159) # Ğ -> ğ
            elif b2 == 176
                res += "i" # İ -> i
            elif (b2 % 2 == 0) and b2 >= 128 and b2 <= 174
                res += chr(196) + chr(b2 + 1) # Ā->ā, Ć->ć, Č->č, Ď->ď...
            else
                res += char_at(s, i) + char_at(s, i + 1)
            end
            i += 2
        elif b1 == 197 and i + 1 < slen
            # Latin Extended-A (0xC5) - Turkish Ş, Polish Ł, Ś, Ž...
            let b2 = ord(char_at(s, i + 1))
            if b2 == 158
                res += chr(197) + chr(159) # Ş -> ş
            elif (b2 % 2 == 1) and b2 >= 129 and b2 <= 147
                res += chr(197) + chr(b2 + 1) # Ł->ł, Ń->ń, Ň->ň...
            elif (b2 % 2 == 0) and b2 >= 160 and b2 <= 190
                res += chr(197) + chr(b2 + 1) # Š->š, Ť->ť, Ž->ž...
            elif b2 >= 185 and b2 <= 188 and (b2 % 2 == 1)
                res += chr(197) + chr(b2 + 1) # Ź->ź, Ż->ż
            else
                res += char_at(s, i) + char_at(s, i + 1)
            end
            i += 2
        elif b1 == 208 and i + 1 < slen
            # Cyrillic part 1 (0xD0) - Russian, Ukrainian, Bulgarian, Serbian
            let b2 = ord(char_at(s, i + 1))
            if b2 >= 144 and b2 <= 159
                res += chr(208) + chr(b2 + 32) # А-П -> а-п
            elif b2 >= 160 and b2 <= 175
                res += chr(209) + chr(b2 - 32) # Р-Я -> р-я
            elif b2 == 129
                res += chr(209) + chr(145) # Ё -> ё
            elif b2 == 132
                res += chr(209) + chr(148) # Є -> є
            elif b2 == 134
                res += chr(209) + chr(150) # І -> і
            elif b2 == 135
                res += chr(209) + chr(151) # Ї -> ї
            else
                res += char_at(s, i) + char_at(s, i + 1)
            end
            i += 2
        elif b1 == 206 and i + 1 < slen
            # Greek part 1 (0xCE)
            let b2 = ord(char_at(s, i + 1))
            if b2 >= 145 and b2 <= 159
                res += chr(206) + chr(b2 + 32) # Α-Ο -> α-ο
            elif b2 >= 160 and b2 <= 169
                res += chr(207) + chr(b2 - 32) # Π-Ω -> π-ω
            else
                res += char_at(s, i) + char_at(s, i + 1)
            end
            i += 2
        else
            res += char_at(s, i)
            i += 1
        end
    end
    return res
end

# Checks if a position in text matches word boundary \b or \B
function check_word_boundary(text, pos, text_len, is_positive)
    let before_word = 0
    let after_word = 0
    if pos > 0
        before_word = is_word_char(char_at(text, pos - 1))
    end
    if pos < text_len
        after_word = is_word_char(char_at(text, pos))
    end

    let is_bound = 0
    if before_word != after_word
        is_bound = 1
    end

    if is_positive == 1
        return is_bound
    end
    if is_bound == 1
        return 0
    end
    return 1
end

# Escapes all regular expression meta-characters in a literal string
function escape_pattern(str_val)
    let slen = len(str_val)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(str_val, i)
        if ch == "\\" or ch == "^" or ch == "$" or ch == "." or ch == "*" or ch == "+" or ch == "?" or ch == "(" or ch == ")" or ch == "[" or ch == "]" or ch == "{" or ch == "}" or ch == "|" or ch == "/" or ch == "-"
            res += "\\"
            res += ch
        else
            res += ch
        end
        i += 1
    end
    return res
end
