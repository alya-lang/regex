## # regex/vm
##
## Virtual machine and execution engine for regex matching.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Implements a backtracking Pike-style VM with catastrophic-backtracking
## protection, plus search, replace, and split operations over compiled patterns.

import "./types.alya"
import "./utils.alya"

# ───────────────────────────────────────────────────────────────
# Backtracking Step Engine
# ───────────────────────────────────────────────────────────────

## Evaluates a single instruction step with backtracking.
##
## Aborts safely (returns null) past one million steps to protect against
## catastrophic backtracking and infinite loops.
##
## ### Parameters
## - `code`: Bytecode instruction array.
## - `pc`: Program counter address of the current instruction.
## - `text`: Input text string.
## - `pos`: Current byte position in the text.
## - `text_len`: Total text byte length.
## - `slots`: Capture slot array mutated during matching.
## - `flag_i`: Case-insensitive flag (`1` enabled, `0` disabled).
## - `flag_m`: Multiline flag (`1` enabled, `0` disabled).
## - `flag_s`: Dot-all flag (`1` enabled, `0` disabled).
## - `counter`: Single-element step budget array.
##
## ### Returns
## Result slot array on success, null when the path fails.
pub function _vm_step(code: array, pc: int, text: string, pos: int, text_len: int, slots: array, flag_i: int, flag_m: int, flag_s: int, counter: array)
    # Protection against catastrophic backtracking / infinite loops
    counter[0] += 1
    if counter[0] > 1000000
        return null
    end

    let inst = code[pc]
    let op = inst.op

    if op == op_char()
        if pos >= text_len return null end
        if ord(char_at(text, pos)) == inst.arg1
            return _vm_step(code, pc + 1, text, pos + 1, text_len, slots, flag_i, flag_m, flag_s, counter)
        end
        return null
    end

    if op == op_char_ci()
        if pos >= text_len return null end
        let b0 = ord(char_at(text, pos))
        # Handle 2-byte UTF-8 sequences (Turkish, Latin-1, Cyrillic, Greek, Polish, etc.)
        if b0 >= 192 and b0 <= 223 and pos + 1 < text_len
            let b1 = ord(char_at(text, pos + 1))
            let pair = to_lower_utf8_pair(b0, b1)
            # Case 1: Mapped to single-byte ASCII (e.g. Turkish uppercase İ [196, 176] -> lowercase 'i' [105])
            if pair[1] == -1
                if inst.arg1 == pair[0]
                    return _vm_step(code, pc + 1, text, pos + 2, text_len, slots, flag_i, flag_m, flag_s, counter)
                end
            end
            # Case 2: 2-byte sequence match
            if inst.arg1 == pair[0]
                if pc + 1 < len(code)
                    let next_inst = code[pc + 1]
                    if next_inst.op == op_char_ci() and next_inst.arg1 == pair[1]
                        return _vm_step(code, pc + 2, text, pos + 2, text_len, slots, flag_i, flag_m, flag_s, counter)
                    end
                end
            end
        end
        let c = to_lower_code(b0)
        if c == inst.arg1
            return _vm_step(code, pc + 1, text, pos + 1, text_len, slots, flag_i, flag_m, flag_s, counter)
        end
        return null
    end

    if op == op_any()
        if pos >= text_len return null end
        let ch = char_at(text, pos)
        if inst.arg1 == 1 or ch != "\n"
            return _vm_step(code, pc + 1, text, pos + 1, text_len, slots, flag_i, flag_m, flag_s, counter)
        end
        return null
    end

    if op == op_class()
        if pos >= text_len return null end
        let code_val = ord(char_at(text, pos))
        if flag_i == 1
            code_val = to_lower_code(code_val)
        end
        let ranges = inst.inst_sub
        let matched = 0
        let ri = 0
        let rcnt = len(ranges)
        while ri < rcnt
            let r = ranges[ri]
            if code_val >= r[0] and code_val <= r[1]
                matched = 1
                break
            end
            ri += 1
        end

        if inst.arg1 == 1
            if matched == 1
                matched = 0
            else
                matched = 1
            end
        end

        if matched == 1
            return _vm_step(code, pc + 1, text, pos + 1, text_len, slots, flag_i, flag_m, flag_s, counter)
        end
        return null
    end

    if op == op_backref()
        let gid = inst.arg1
        let gs = slots[gid * 2]
        let ge = slots[gid * 2 + 1]
        if gs < 0 or ge < gs
            return null
        end
        let ref_len = ge - gs
        if pos + ref_len > text_len
            return null
        end
        if ref_len > 0
            if flag_i == 1
                let s1 = to_lower_string(substring(text, pos, ref_len))
                let s2 = to_lower_string(substring(text, gs, ref_len))
                if s1 != s2 return null end
            else
                let s1 = substring(text, pos, ref_len)
                let s2 = substring(text, gs, ref_len)
                if s1 != s2 return null end
            end
        end
        return _vm_step(code, pc + 1, text, pos + ref_len, text_len, slots, flag_i, flag_m, flag_s, counter)
    end

    if op == op_lookahead()
        let is_positive = inst.arg1
        let sub_slots = [pos, -1]
        let sub_res = _vm_step(inst.inst_sub, 0, text, pos, text_len, sub_slots, flag_i, flag_m, flag_s, [0])
        if is_positive == 1
            if sub_res is null return null end
        else
            if sub_res is not null return null end
        end
        return _vm_step(code, pc + 1, text, pos, text_len, slots, flag_i, flag_m, flag_s, counter)
    end

    if op == op_lookbehind()
        let is_positive = inst.arg1
        let matched = 0
        let test_start = 0
        while test_start <= pos
            let sub_slots = [test_start, -1]
            let sub_res = _vm_step(inst.inst_sub, 0, text, test_start, text_len, sub_slots, flag_i, flag_m, flag_s, [0])
            if sub_res is not null
                if sub_res[1] == pos
                    matched = 1
                    break
                end
            end
            test_start += 1
        end
        if is_positive == 1
            if matched == 0 return null end
        else
            if matched == 1 return null end
        end
        return _vm_step(code, pc + 1, text, pos, text_len, slots, flag_i, flag_m, flag_s, counter)
    end

    if op == op_match()
        let res = []
        let si = 0
        let scnt = len(slots)
        while si < scnt
            res.push(slots[si])
            si += 1
        end
        return res
    end

    if op == op_jump()
        return _vm_step(code, inst.arg1, text, pos, text_len, slots, flag_i, flag_m, flag_s, counter)
    end

    if op == op_split()
        let res1 = _vm_step(code, inst.arg1, text, pos, text_len, slots, flag_i, flag_m, flag_s, counter)
        if res1 is not null
            return res1
        end
        return _vm_step(code, inst.arg2, text, pos, text_len, slots, flag_i, flag_m, flag_s, counter)
    end

    if op == op_save()
        let slot_idx = inst.arg1
        let old_val = slots[slot_idx]
        slots[slot_idx] = pos
        let res = _vm_step(code, pc + 1, text, pos, text_len, slots, flag_i, flag_m, flag_s, counter)
        if res is not null
            return res
        end
        slots[slot_idx] = old_val
        return null
    end

    if op == op_assert_start()
        let ok = 0
        if pos == 0
            ok = 1
        elif inst.arg1 == 1 and pos > 0 and char_at(text, pos - 1) == "\n"
            ok = 1
        end
        if ok == 1
            return _vm_step(code, pc + 1, text, pos, text_len, slots, flag_i, flag_m, flag_s, counter)
        end
        return null
    end

    if op == op_assert_end()
        let ok = 0
        if pos == text_len
            ok = 1
        elif inst.arg1 == 1 and pos < text_len and char_at(text, pos) == "\n"
            ok = 1
        end
        if ok == 1
            return _vm_step(code, pc + 1, text, pos, text_len, slots, flag_i, flag_m, flag_s, counter)
        end
        return null
    end

    if op == op_assert_word()
        if check_word_boundary(text, pos, text_len, 1) == 1
            return _vm_step(code, pc + 1, text, pos, text_len, slots, flag_i, flag_m, flag_s, counter)
        end
        return null
    end

    if op == op_assert_not_word()
        if check_word_boundary(text, pos, text_len, 0) == 1
            return _vm_step(code, pc + 1, text, pos, text_len, slots, flag_i, flag_m, flag_s, counter)
        end
        return null
    end

    return null
end

# ───────────────────────────────────────────────────────────────
# Match Execution & Search
# ───────────────────────────────────────────────────────────────

## Executes a compiled regex at an exact start position.
##
## ### Parameters
## - `reg`: Compiled `Regex` instance.
## - `text`: Input text string.
## - `start_pos`: Byte position where matching must begin.
## - `text_len`: Total text byte length.
##
## ### Returns
## A `Match` instance on success, null when the position fails.
pub function vm_exec_at(reg, text: string, start_pos: int, text_len: int)
    let num_slots = (reg.num_groups + 1) * 2
    let slots = []
    let i = 0
    while i < num_slots
        slots.push(-1)
        i += 1
    end
    slots[0] = start_pos

    let counter = [0]
    let result_slots = _vm_step(reg.code, 0, text, start_pos, text_len, slots, reg.flag_i, reg.flag_m, reg.flag_s, counter)

    if result_slots is null
        return null
    end

    let m_start = result_slots[0]
    let m_end = result_slots[1]
    let m_text = substring(text, m_start, m_end - m_start)

    let groups = [m_text]
    let spans = [[m_start, m_end]]

    let g = 1
    while g <= reg.num_groups
        let gs = result_slots[g * 2]
        let ge = result_slots[g * 2 + 1]
        if gs >= 0 and ge >= gs
            groups.push(substring(text, gs, ge - gs))
            spans.push([gs, ge])
        else
            groups.push("")
            spans.push([-1, -1])
        end
        g += 1
    end

    return match_new(m_text, m_start, m_end, groups, spans, reg.named_groups)
end

## Searches for the first match at or after a start index.
##
## Anchored patterns only attempt position `0`; otherwise a literal prefix
## fast-scan skips hopeless start positions before executing bytecode.
##
## ### Parameters
## - `reg`: Compiled `Regex` instance.
## - `text`: Input text string.
## - `start_index`: Byte position where the search begins. Defaults to `0`.
##
## ### Returns
## A `Match` instance on success, null when no match exists.
##
## ### Examples
## ```alya
## let m = vm_search(re, "say hi", 0)
## ```
pub function vm_search(reg, text: string, start_index: int = 0)
    let text_len = len(text)
    if start_index > text_len
        return null
    end

    if reg.is_anchored == 1
        if start_index > 0
            return null
        end
        return vm_exec_at(reg, text, 0, text_len)
    end

    let prefix = reg.prefix
    let plen = len(prefix)
    let pos = start_index

    while pos <= text_len
        if plen > 0
            if pos + plen > text_len
                return null
            end
            if reg.flag_i == 1
                let sub = to_lower_string(substring(text, pos, plen))
                if sub != prefix
                    pos += 1
                    continue
                end
            else
                let sub = substring(text, pos, plen)
                if sub != prefix
                    pos += 1
                    continue
                end
            end
        end

        let m = vm_exec_at(reg, text, pos, text_len)
        if m is not null
            return m
        end
        pos += 1
    end

    return null
end

## Finds all non-overlapping matches in text order.
##
## Zero-width matches advance by one byte to guarantee termination.
##
## ### Parameters
## - `reg`: Compiled `Regex` instance.
## - `text`: Input text string.
##
## ### Returns
## Array of `Match` instances (possibly empty).
pub function vm_find_all(reg, text: string) -> array
    let matches = []
    let text_len = len(text)
    let pos = 0

    while pos <= text_len
        let m = vm_search(reg, text, pos)
        if m is null
            break
        end
        matches.push(m)
        pos = when
            m.m_end > m.m_start => m.m_end
            else                => m.m_start + 1
        end
    end

    return matches
end

# ───────────────────────────────────────────────────────────────
# Replacement & Splitting
# ───────────────────────────────────────────────────────────────

## Expands replacement templates (`$0`, `$1`, `${name}`, `$&`, `$$`).
##
## ### Parameters
## - `template_str`: Replacement template string.
## - `m`: Match providing capture values.
##
## ### Returns
## The expanded replacement string.
##
## ### Examples
## ```alya
## say _expand_replacement("$2, $1", m) # "Doe, John"
## ```
pub function _expand_replacement(template_str: string, m) -> string
    let tlen = len(template_str)
    let res = ""
    let i = 0

    while i < tlen
        let ch = char_at(template_str, i)
        if ch == "$" and i + 1 < tlen
            let next_ch = char_at(template_str, i + 1)
            when next_ch
                is "$"
                    res += "$"
                    i += 2
                    continue
                is "&", "0"
                    res += match_text(m)
                    i += 2
                    continue
                is "1", "2", "3", "4", "5", "6", "7", "8", "9"
                    let g_idx = int(next_ch)
                    res += match_group(m, g_idx)
                    i += 2
                    continue
                is "{", "<"
                    let close_ch = "}"
                    if next_ch == "<" close_ch = ">" end
                    let name = ""
                    let ni = i + 2
                    while ni < tlen and char_at(template_str, ni) != close_ch
                        name += char_at(template_str, ni)
                        ni += 1
                    end
                    if ni < tlen and char_at(template_str, ni) == close_ch
                        res += match_named(m, name)
                        i = ni + 1
                        continue
                    end
            end
        end
        res += ch
        i += 1
    end

    return res
end

## Replaces matched occurrences with an expanded replacement template.
##
## ### Parameters
## - `reg`: Compiled `Regex` instance.
## - `text`: Input text string.
## - `replacement`: Replacement template string.
## - `is_all`: `1` replaces every match, `0` replaces the first only. Defaults to `1`.
##
## ### Returns
## The resulting string with replacements applied.
pub function vm_replace(reg, text: string, replacement: string, is_all: int = 1) -> string
    let matches = []
    if is_all == 1
        matches = vm_find_all(reg, text)
    else
        let first_m = vm_search(reg, text, 0)
        if first_m is not null
            matches.push(first_m)
        end
    end

    if len(matches) == 0
        return text
    end

    let res = ""
    let last_idx = 0
    let mi = 0
    let mcnt = len(matches)

    while mi < mcnt
        let m = matches[mi]
        if m.m_start > last_idx
            res += substring(text, last_idx, m.m_start - last_idx)
        end
        res += _expand_replacement(replacement, m)
        last_idx = m.m_end
        mi += 1
    end

    let text_len = len(text)
    if last_idx < text_len
        res += substring(text, last_idx, text_len - last_idx)
    end

    return res
end

## Splits text by regex matches, honoring an optional segment limit.
##
## ### Parameters
## - `reg`: Compiled `Regex` instance.
## - `text`: Input text string.
## - `limit`: Maximum segment count (`-1` for unlimited). Defaults to `-1`.
##
## ### Returns
## Array of segment strings.
pub function vm_split(reg, text: string, limit: int = -1) -> array
    let matches = vm_find_all(reg, text)
    let mcnt = len(matches)
    if mcnt == 0
        return [text]
    end

    let parts = []
    let last_idx = 0
    let mi = 0

    while mi < mcnt
        if limit > 0 and len(parts) >= limit - 1
            break
        end
        let m = matches[mi]
        let segment = substring(text, last_idx, m.m_start - last_idx)
        parts.push(segment)
        last_idx = m.m_end
        mi += 1
    end

    let text_len = len(text)
    if last_idx <= text_len
        parts.push(substring(text, last_idx, text_len - last_idx))
    end

    return parts
end
