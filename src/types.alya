## Types and data structures for regex engine
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

## Virtual machine instruction opcodes
pub enum Opcode
    Char = 1
    CharCi = 2
    Any = 3
    Class = 4
    Match = 5
    Jump = 6
    Split = 7
    Save = 8
    AssertStart = 9
    AssertEnd = 10
    AssertWord = 11
    AssertNotWord = 12
    Backref = 13
    Lookahead = 14
    Lookbehind = 15
end

## Opcode getters for backward compatibility
pub function op_char() return Opcode.Char end
pub function op_char_ci() return Opcode.CharCi end
pub function op_any() return Opcode.Any end
pub function op_class() return Opcode.Class end
pub function op_match() return Opcode.Match end
pub function op_jump() return Opcode.Jump end
pub function op_split() return Opcode.Split end
pub function op_save() return Opcode.Save end
pub function op_assert_start() return Opcode.AssertStart end
pub function op_assert_end() return Opcode.AssertEnd end
pub function op_assert_word() return Opcode.AssertWord end
pub function op_assert_not_word() return Opcode.AssertNotWord end
pub function op_backref() return Opcode.Backref end
pub function op_lookahead() return Opcode.Lookahead end
pub function op_lookbehind() return Opcode.Lookbehind end

## AST Node kind discriminator enum
pub enum AstKind
    Empty = 0
    Literal = 1
    Any = 2
    Class = 3
    AnchorStart = 4
    AnchorEnd = 5
    WordBoundary = 6
    NotWordBoundary = 7
    Concat = 8
    Alt = 9
    Group = 10
    Quantifier = 11
    Backref = 12
    Lookaround = 13
end

## AST node kind getters for backward compatibility
pub function ast_kind_empty() return AstKind.Empty end
pub function ast_kind_literal() return AstKind.Literal end
pub function ast_kind_any() return AstKind.Any end
pub function ast_kind_class() return AstKind.Class end
pub function ast_kind_anchor_start() return AstKind.AnchorStart end
pub function ast_kind_anchor_end() return AstKind.AnchorEnd end
pub function ast_kind_word_boundary() return AstKind.WordBoundary end
pub function ast_kind_not_word_boundary() return AstKind.NotWordBoundary end
pub function ast_kind_concat() return AstKind.Concat end
pub function ast_kind_alt() return AstKind.Alt end
pub function ast_kind_group() return AstKind.Group end
pub function ast_kind_quantifier() return AstKind.Quantifier end
pub function ast_kind_backref() return AstKind.Backref end
pub function ast_kind_lookaround() return AstKind.Lookaround end

# Struct representing a single virtual machine instruction (internal)
struct Instruction
    op,
    arg1,
    arg2,
    inst_sub: any[]
end

pub function inst_new(op, arg1 = 0, arg2 = 0, inst_sub: any[] = [])
    return Instruction {
        op: op,
        arg1: arg1,
        arg2: arg2,
        inst_sub: inst_sub
    }
end

# Struct representing an AST node (internal)
struct AstNode
    kind,
    val1,
    val2,
    node_data: any[],
    children: any[],
    group_name
end

pub function ast_node_new(kind, val1 = 0, val2 = 0, node_data: any[] = [], children: any[] = [], group_name = "")
    return AstNode {
        kind: kind,
        val1: val1,
        val2: val2,
        node_data: node_data,
        children: children,
        group_name: group_name
    }
end

## Compiled regular expression instance
pub struct Regex
    pattern,
    flags,
    code: any[],
    num_groups,
    is_anchored,
    prefix,
    flag_i,
    flag_m,
    flag_s,
    named_groups,
    group_names
end

## Creates a new Regex instance
pub function regex_new(pattern, flags, code: any[], num_groups, is_anchored, prefix, flag_i, flag_m, flag_s, named_groups = {}, group_names = {})
    return Regex {
        pattern: pattern,
        flags: flags,
        code: code,
        num_groups: num_groups,
        is_anchored: is_anchored,
        prefix: prefix,
        flag_i: flag_i,
        flag_m: flag_m,
        flag_s: flag_s,
        named_groups: named_groups,
        group_names: group_names
    }
end

## Represents a successful regex match with matched text and capture groups
pub struct Match
    m_text
    m_start
    m_end
    m_groups
    m_spans
    m_named_groups
end

## Creates a new Match instance
pub function match_new(text, start_pos, end_pos, groups = [], spans = [], named_groups = {})
    return Match {
        m_text: text,
        m_start: start_pos,
        m_end: end_pos,
        m_groups: groups,
        m_spans: spans,
        m_named_groups: named_groups
    }
end

## Returns full matched text
pub function match_text(m)
    if m is null return "" end
    return m.m_text
end

## Returns starting 0-indexed byte offset of match
pub function match_start(m)
    if m is null return -1 end
    return m.m_start
end

## Returns ending 0-indexed byte offset (exclusive) of match
pub function match_end(m)
    if m is null return -1 end
    return m.m_end
end

## Returns byte length of matched substring
pub function match_len(m)
    if m is null return 0 end
    return m.m_end - m.m_start
end

## Returns captured group text by 1-indexed group number (or 0 for entire match)
pub function match_group(m, idx = 0)
    if m is null return "" end
    let groups = m.m_groups
    let i = int(idx)
    if i >= 0 and i < len(groups)
        return groups[i]
    end
    return ""
end

## Returns captured group text by group name
pub function match_named(m, name)
    if m is null return "" end
    let named = m.m_named_groups
    if named is not null
        if has(named, name) == 1
            let g_idx = named[name]
            return match_group(m, g_idx)
        end
    end
    return ""
end

## Returns array of all captured group strings
pub function match_groups(m)
    if m is null return [] end
    return m.m_groups
end

## Returns [start, end] span array for group idx
pub function match_span(m, idx = 0)
    if m is null return [-1, -1] end
    let spans = m.m_spans
    if idx >= 0 and idx < len(spans)
        return spans[idx]
    end
    return [-1, -1]
end

# --- Struct Methods (Alya v0.0.18) ---

## Returns matched text
pub function Match.text(self)
    return match_text(self)
end

## Returns match start position
pub function Match.start(self)
    return match_start(self)
end

## Returns match end position
pub function Match.end_pos(self)
    return match_end(self)
end

## Returns match length
pub function Match.len(self)
    return match_len(self)
end

## Returns captured group by index
pub function Match.group(self, idx = 0)
    return match_group(self, idx)
end

## Returns captured group by name
pub function Match.named(self, name)
    return match_named(self, name)
end

## Returns all captured group strings
pub function Match.groups(self)
    return match_groups(self)
end

## Returns [start, end] span for group index
pub function Match.span(self, idx = 0)
    return match_span(self, idx)
end
