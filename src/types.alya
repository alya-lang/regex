# Types and data structures for regex engine
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Opcode constants
let OP_CHAR = 1              # Matches specific char code: arg1 = char_code
let OP_CHAR_CI = 2           # Case-insensitive char: arg1 = lowercase char_code
let OP_ANY = 3               # Matches any character except \n (or any if dotall)
let OP_CLASS = 4             # Character class: extra = ranges, arg1 = negated (0 or 1)
let OP_MATCH = 5             # Match success
let OP_JUMP = 6              # Unconditional jump: arg1 = target_pc
let OP_SPLIT = 7             # Branching: arg1 = target1, arg2 = target2
let OP_SAVE = 8              # Save capture position: arg1 = slot index
let OP_ASSERT_START = 9      # ^ (start of text or line)
let OP_ASSERT_END = 10       # $ (end of text or line)
let OP_ASSERT_WORD = 11      # \b (word boundary)
let OP_ASSERT_NOT_WORD = 12  # \B (non-word boundary)
let OP_BACKREF = 13          # \1..\9 backreference to captured group: arg1 = gid
let OP_LOOKAHEAD = 14        # (?=...) or (?!...): arg1 = is_positive, extra = sub_code
let OP_LOOKBEHIND = 15       # (?<=...) or (?<!...): arg1 = is_positive, extra = sub_code

# Opcode getters for function scopes
function op_char() return 1 end
function op_char_ci() return 2 end
function op_any() return 3 end
function op_class() return 4 end
function op_match() return 5 end
function op_jump() return 6 end
function op_split() return 7 end
function op_save() return 8 end
function op_assert_start() return 9 end
function op_assert_end() return 10 end
function op_assert_word() return 11 end
function op_assert_not_word() return 12 end
function op_backref() return 13 end
function op_lookahead() return 14 end
function op_lookbehind() return 15 end

# AST Node Kind constants
let AST_EMPTY = 0
let AST_LITERAL = 1
let AST_ANY = 2
let AST_CLASS = 3
let AST_ANCHOR_START = 4
let AST_ANCHOR_END = 5
let AST_WORD_BOUNDARY = 6
let AST_NOT_WORD_BOUNDARY = 7
let AST_CONCAT = 8
let AST_ALT = 9
let AST_GROUP = 10
let AST_QUANTIFIER = 11
let AST_BACKREF = 12
let AST_LOOKAROUND = 13

function ast_kind_empty() return 0 end
function ast_kind_literal() return 1 end
function ast_kind_any() return 2 end
function ast_kind_class() return 3 end
function ast_kind_anchor_start() return 4 end
function ast_kind_anchor_end() return 5 end
function ast_kind_word_boundary() return 6 end
function ast_kind_not_word_boundary() return 7 end
function ast_kind_concat() return 8 end
function ast_kind_alt() return 9 end
function ast_kind_group() return 10 end
function ast_kind_quantifier() return 11 end
function ast_kind_backref() return 12 end
function ast_kind_lookaround() return 13 end

# Struct representing a single virtual machine instruction
struct Instruction
    op
    arg1
    arg2
    inst_sub
end

function inst_new(op, arg1 = 0, arg2 = 0, inst_sub = null)
    return Instruction {
        op: op,
        arg1: arg1,
        arg2: arg2,
        inst_sub: inst_sub
    }
end

# Struct representing an AST node
struct AstNode
    kind
    val1
    val2
    node_data
    children
    group_name
end

function ast_node_new(kind, val1 = 0, val2 = 0, node_data = null, children = null, group_name = "")
    return AstNode {
        kind: kind,
        val1: val1,
        val2: val2,
        node_data: node_data,
        children: children,
        group_name: group_name
    }
end

# Struct representing a compiled regular expression
struct Regex
    pattern
    flags
    code
    num_groups
    is_anchored
    prefix
    flag_i
    flag_m
    flag_s
    named_groups
    group_names
end

function regex_new(pattern, flags, code, num_groups, is_anchored, prefix, flag_i, flag_m, flag_s, named_groups = {}, group_names = {})
    return Regex {
        pattern: pattern,
        flags: flags,
        code: code,
        num_groups: num_groups,
        is_anchored: is_anchored,
        prefix: prefix,
        flag_i: flag_i,
        flag_m: flag_m,
        flag_s: flag_s,
        named_groups: named_groups,
        group_names: group_names
    }
end

# Struct representing a regex match result
struct Match
    m_text
    m_start
    m_end
    m_groups
    m_spans
    m_named_groups
end

function match_new(text, start_pos, end_pos, groups = [], spans = [], named_groups = {})
    return Match {
        m_text: text,
        m_start: start_pos,
        m_end: end_pos,
        m_groups: groups,
        m_spans: spans,
        m_named_groups: named_groups
    }
end

# Match inspection helper functions
function match_text(m)
    if m == null return "" end
    return m.m_text
end

function match_start(m)
    if m == null return -1 end
    return m.m_start
end

function match_end(m)
    if m == null return -1 end
    return m.m_end
end

function match_len(m)
    if m == null return 0 end
    return m.m_end - m.m_start
end

function match_group(m, idx = 0)
    if m == null return "" end
    let groups = m.m_groups
    let i = int(idx)
    if i >= 0 and i < len(groups)
        return groups[i]
    end
    return ""
end

function match_named(m, name)
    if m == null return "" end
    let named = m.m_named_groups
    if named != null
        if has(named, name) == 1
            let g_idx = named[name]
            return match_group(m, g_idx)
        end
    end
    return ""
end

function match_groups(m)
    if m == null return [] end
    return m.m_groups
end

function match_span(m, idx = 0)
    if m == null return [-1, -1] end
    let spans = m.m_spans
    if idx >= 0 and idx < len(spans)
        return spans[idx]
    end
    return [-1, -1]
end
